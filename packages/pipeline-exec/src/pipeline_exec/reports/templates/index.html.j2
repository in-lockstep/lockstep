<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pipeline Reports</title>
<style>
:root {
  --bg: #0f1117; --surface: #1a1d27; --surface2: #242836;
  --border: #2e3348; --text: #e1e4ed; --text-dim: #8b90a5;
  --pass: #34d399; --fail: #f87171; --skip: #fbbf24; --info: #60a5fa;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; padding: 24px; max-width: 900px; margin: 0 auto; }
h1 { font-size: 24px; font-weight: 600; margin-bottom: 4px; }
.subtitle { color: var(--text-dim); font-size: 14px; margin-bottom: 24px; }
a { color: var(--info); text-decoration: none; }
a:hover { text-decoration: underline; }
.run-list { list-style: none; }
.run-item { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; margin-bottom: 10px; }
.run-item:hover { background: var(--surface2); }
.run-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.run-name { font-weight: 600; font-size: 15px; }
.run-date { color: var(--text-dim); font-size: 13px; }
.badge { font-size: 11px; padding: 2px 6px; border-radius: 10px; font-weight: 600; margin-left: 6px; }
.badge.latest { background: rgba(52,211,153,0.15); color: var(--pass); }
.badge.full { background: rgba(96,165,250,0.15); color: var(--info); }
.badge.partial { background: rgba(251,191,36,0.15); color: #fbbf24; }
.mini-cards { display: flex; gap: 6px; flex-wrap: wrap; }
.mini-card { background: var(--bg); border-radius: 6px; padding: 4px 10px; min-width: 60px; text-align: center; }
.mini-label { font-size: 9px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.5px; }
.mini-value { font-size: 16px; font-weight: 700; }
.mini-value.pass { color: var(--pass); }
.mini-value.fail { color: var(--fail); }
.mini-value.info { color: var(--info); }
.mini-value.skip { color: var(--skip); }
.progress { display: flex; height: 4px; border-radius: 2px; overflow: hidden; background: var(--surface2); margin-top: 6px; }
.progress .seg { height: 100%; }
.progress .seg.pass { background: var(--pass); }
.progress .seg.fail { background: var(--fail); }
.progress .seg.skip { background: var(--skip); }
.filter-bar { display: flex; gap: 8px; margin-bottom: 16px; }
.filter-btn { font-size: 12px; padding: 4px 12px; border-radius: 16px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); cursor: pointer; }
.filter-btn.active { border-color: var(--info); color: var(--info); background: rgba(96,165,250,0.1); }
</style>
</head>
<body>
<h1>Pipeline Reports</h1>
<div class="subtitle">{{ runs|length }} test run(s) available</div>

<div class="filter-bar">
  <button class="filter-btn" onclick="filterRuns('all')" data-filter="all">All</button>
  <button class="filter-btn active" onclick="filterRuns('Full')" data-filter="Full">Full Runs</button>
  <button class="filter-btn" onclick="filterRuns('Partial')" data-filter="Partial">Partial Runs</button>
</div>

<ul class="run-list" id="run-list">
{% for r in runs %}
  <li class="run-item" data-runtype="{{ r.runType }}">
    <div class="run-header">
      <div>
        <span class="run-name">
          {% if r.hasDashboard %}<a href="runs/{{ r.name }}/dashboard.html">{{ r.name }}</a>
          {% else %}{{ r.name }}{% endif %}
        </span>
        {% if loop.first %}<span class="badge latest">Latest</span>{% endif %}
        <span class="badge {{ r.runType|lower }}">{{ r.runType }}</span>
        {% if r.version %}<span class="badge" style="background:rgba(96,165,250,0.15);color:var(--info)">{{ r.version }}</span>{% endif %}
      </div>
      <div class="run-date">{{ r.date }}</div>
    </div>
    <div class="mini-cards">
      <div class="mini-card"><div class="mini-label">Pass Rate</div><div class="mini-value pass">{{ r.passRate }}%</div></div>
      <div class="mini-card"><div class="mini-label">Steps</div><div class="mini-value info">{{ r.stepCompletion }}%</div></div>
      <div class="mini-card"><div class="mini-label">Passed</div><div class="mini-value pass">{{ r.passed }}</div></div>
      <div class="mini-card"><div class="mini-label">Failed</div><div class="mini-value fail">{{ r.failed }}</div></div>
      {% if r.skipped > 0 %}
      <div class="mini-card"><div class="mini-label">Skipped</div><div class="mini-value skip">{{ r.skipped }}</div></div>
      {% endif %}
      <div class="mini-card"><div class="mini-label">Total</div><div class="mini-value info">{{ r.total }}</div></div>
      {% if r.appBugs > 0 %}
      <div class="mini-card"><div class="mini-label">App Bugs</div><div class="mini-value fail">{{ r.appBugs }}</div></div>
      {% endif %}
    </div>
    {% set total = r.passed + r.failed %}
    {% if total > 0 %}
    <div class="progress">
      <div class="seg pass" style="width:{{ (r.passed / total * 100)|round }}%"></div>
      <div class="seg fail" style="width:{{ (r.failed / total * 100)|round }}%"></div>
      {% if r.total > 0 and r.skipped > 0 %}
      <div class="seg skip" style="width:{{ (r.skipped / r.total * 100)|round }}%"></div>
      {% endif %}
    </div>
    {% endif %}
  </li>
{% endfor %}
</ul>

{% if runs|length == 0 %}
<p style="color: var(--text-dim); text-align: center; padding: 40px;">
  No test runs found. Run <code>uv run pipeline test-run</code> to generate results.
</p>
{% endif %}

<script>
function filterRuns(type) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === type));
  document.querySelectorAll('.run-item').forEach(item => {
    if (type === 'all') { item.style.display = ''; return; }
    item.style.display = item.dataset.runtype === type ? '' : 'none';
  });
}
filterRuns('Full');
</script>
</body>
</html>
