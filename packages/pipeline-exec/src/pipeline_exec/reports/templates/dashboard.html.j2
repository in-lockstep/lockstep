<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pipeline Dashboard</title>
<style>
:root {
  --bg: #0f1117; --surface: #1a1d27; --surface2: #242836;
  --border: #2e3348; --text: #e1e4ed; --text-dim: #8b90a5;
  --pass: #34d399; --fail: #f87171; --skip: #fbbf24; --warn: #fb923c; --info: #60a5fa;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
a { color: var(--info); text-decoration: none; }
a:hover { text-decoration: underline; }
.container { max-width: 1200px; margin: 0 auto; padding: 20px; }

/* Header */
.header { padding: 20px 0; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
.header h1 { font-size: 22px; font-weight: 600; }
.header .subtitle { color: var(--text-dim); font-size: 13px; margin-top: 4px; }
.version-badge { display: inline-block; background: rgba(96,165,250,0.15); color: var(--info); padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; margin-left: 8px; }
.run-type-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; margin-left: 6px; }
.run-type-badge.full { background: rgba(96,165,250,0.15); color: var(--info); }
.run-type-badge.partial { background: rgba(251,191,36,0.15); color: var(--skip); }

/* Summary Cards */
.cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; min-width: 120px; cursor: pointer; transition: border-color 0.2s; }
.card:hover { border-color: var(--text-dim); }
.card.active { border-color: var(--info); }
.card .label { font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.5px; }
.card .value { font-size: 28px; font-weight: 700; margin-top: 2px; }
.card .value.pass { color: var(--pass); }
.card .value.fail { color: var(--fail); }
.card .value.skip { color: var(--skip); }
.card .value.warn { color: var(--warn); }
.card .value.info { color: var(--info); }

/* Filter Bar */
.filter-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.filter-btn { font-size: 12px; padding: 4px 12px; border-radius: 16px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); cursor: pointer; }
.filter-btn.active { border-color: var(--info); color: var(--info); background: rgba(96,165,250,0.1); }

/* Story List */
.story-list { list-style: none; }
.story-item { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; overflow: hidden; }
.story-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; cursor: pointer; }
.story-header:hover { background: var(--surface2); }
.story-id { font-weight: 600; font-size: 14px; }
.story-summary { color: var(--text-dim); font-size: 13px; margin-left: 12px; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.story-status { font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 12px; }
.story-status.passed { background: rgba(52,211,153,0.15); color: var(--pass); }
.story-status.failed { background: rgba(248,113,113,0.15); color: var(--fail); }
.story-status.skipped { background: rgba(251,191,36,0.15); color: var(--skip); }
.story-tags { display: flex; gap: 4px; margin-left: 8px; }
.tag { font-size: 10px; padding: 1px 6px; border-radius: 8px; background: var(--surface2); color: var(--text-dim); }
.tag.app-bug { background: rgba(248,113,113,0.15); color: var(--fail); }

/* Story Detail */
.story-detail { display: none; padding: 0 16px 16px; border-top: 1px solid var(--border); }
.story-detail.open { display: block; }
.step-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
.step-table th { text-align: left; padding: 6px 8px; color: var(--text-dim); font-weight: 500; border-bottom: 1px solid var(--border); }
.step-table td { padding: 6px 8px; border-bottom: 1px solid rgba(46,51,72,0.5); vertical-align: top; }
.step-table tr:last-child td { border-bottom: none; }
.step-status { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
.step-status.passed { background: var(--pass); }
.step-status.failed { background: var(--fail); }
.step-status.warn { background: var(--warn); }
.step-status.skipped { background: var(--skip); }
.step-result { max-height: 150px; overflow-y: auto; font-family: monospace; font-size: 11px; white-space: pre-wrap; word-break: break-all; color: var(--text-dim); background: var(--bg); padding: 6px 8px; border-radius: 4px; margin-top: 4px; }
.step-phase { font-size: 11px; color: var(--text-dim); text-transform: uppercase; }
.screenshot-link { color: var(--info); font-size: 11px; }

/* Progress Bar */
.progress { display: flex; height: 4px; border-radius: 2px; overflow: hidden; background: var(--surface2); margin-top: 6px; }
.progress .seg { height: 100%; }
.progress .seg.pass { background: var(--pass); }
.progress .seg.fail { background: var(--fail); }
.progress .seg.skip { background: var(--skip); }

/* Token Usage */
.token-summary { font-size: 12px; color: var(--text-dim); margin-top: 4px; }
</style>
</head>
<body>
<div class="container">

<div class="header">
  <h1>Pipeline Dashboard
    {% if data.version %}<span class="version-badge">{{ data.version }}</span>{% endif %}
    <span class="run-type-badge {{ data.runType|default('full')|lower }}">{{ data.runType|default('Full') }}</span>
  </h1>
  <div class="subtitle">
    {{ data.grandTotals.passed + data.grandTotals.failed + data.grandTotals.skipped|default(0) }} stories tested
    | Run: {{ data.runTimestamp|default('') }}
    {% if data.totalCost %} | Token cost: ${{ "%.4f"|format(data.totalCost) }}{% endif %}
  </div>
</div>

<div class="cards" id="summary-cards">
  <div class="card" onclick="filterStories('all')">
    <div class="label">Pass Rate</div>
    <div class="value pass">{{ data.passRate|default('0') }}%</div>
  </div>
  <div class="card" onclick="filterStories('all')">
    <div class="label">Step Completion</div>
    <div class="value info">{{ data.meanStepRate|default('0') }}%</div>
  </div>
  <div class="card" onclick="filterStories('passed')">
    <div class="label">Passed</div>
    <div class="value pass">{{ data.grandTotals.passed }}</div>
  </div>
  <div class="card" onclick="filterStories('failed')">
    <div class="label">Failed</div>
    <div class="value fail">{{ data.grandTotals.failed }}</div>
  </div>
  {% if data.grandTotals.skipped|default(0) > 0 %}
  <div class="card" onclick="filterStories('skipped')">
    <div class="label">Skipped</div>
    <div class="value skip">{{ data.grandTotals.skipped }}</div>
  </div>
  {% endif %}
  {% if data.appBugCount|default(0) > 0 %}
  <div class="card" onclick="filterStories('app-bug')">
    <div class="label">App Bugs</div>
    <div class="value fail">{{ data.appBugCount }}</div>
  </div>
  {% endif %}
</div>

{% if data.tags|default([]) %}
<div class="filter-bar" id="tag-filter">
  <button class="filter-btn active" onclick="filterByTag('all')" data-tag="all">All</button>
  {% for tag in data.tags|default([]) %}
  <button class="filter-btn" onclick="filterByTag('{{ tag }}')" data-tag="{{ tag }}">{{ tag }}</button>
  {% endfor %}
</div>
{% endif %}

<ul class="story-list" id="story-list">
{% for story in data.stories|default([]) %}
  <li class="story-item" data-status="{{ story.status|default('failed') }}" data-tags="{{ story.tags|default([])|join(',') }}">
    <div class="story-header" onclick="toggleDetail(this)">
      <span class="story-id">
        {% if story.executionReport %}<a href="executions/{{ story.storyId }}.md" onclick="event.stopPropagation()">{{ story.storyId }}</a>
        {% else %}{{ story.storyId }}{% endif %}
      </span>
      <span class="story-summary">{{ story.summary|default('') }}</span>
      <span class="story-tags">
        {% for tag in story.tags|default([]) %}
        <span class="tag {% if tag == 'app-bug' %}app-bug{% endif %}">{{ tag }}</span>
        {% endfor %}
      </span>
      <span class="story-status {{ story.status|default('failed') }}">{{ story.status|default('FAILED')|upper }}</span>
    </div>
    <div class="story-detail">
      {% if story.steps|default([]) %}
      <table class="step-table">
        <thead>
          <tr><th>Phase</th><th>Step</th><th>Tool</th><th>Action</th><th>Expected</th><th>Status</th></tr>
        </thead>
        <tbody>
        {% for step in story.steps|default([]) %}
          <tr>
            <td><span class="step-phase">{{ step.phase }}</span></td>
            <td>{{ step.stepNumber }}</td>
            <td><code>{{ step.tool }}</code></td>
            <td>{{ step.action|truncate(80) }}</td>
            <td>{{ step.expected|truncate(60) }}</td>
            <td><span class="step-status {{ step.status }}"></span>{{ step.status }}</td>
          </tr>
          {% if step.status == 'failed' %}
          <tr>
            <td colspan="6">
              <div class="step-result">{{ step.result|truncate(500) }}</div>
              {% if step.screenshotPath %}
              <a class="screenshot-link" href="../{{ step.screenshotPath }}">View Screenshot</a>
              {% endif %}
            </td>
          </tr>
          {% endif %}
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
      <div class="progress">
        {% set total = story.steps|default([])|length %}
        {% set p = story.steps|default([])|selectattr('status','equalto','passed')|list|length %}
        {% set f = story.steps|default([])|selectattr('status','equalto','failed')|list|length %}
        {% if total > 0 %}
        <div class="seg pass" style="width:{{ (p / total * 100)|round }}%"></div>
        <div class="seg fail" style="width:{{ (f / total * 100)|round }}%"></div>
        {% endif %}
      </div>
    </div>
  </li>
{% endfor %}
</ul>

{% if data.stories|default([])|length == 0 %}
<p style="color: var(--text-dim); text-align: center; padding: 40px;">
  No test results found. Run <code>uv run pipeline test-run</code> to generate results.
</p>
{% endif %}

</div>

<script src="dashboard-data.js"></script>
<script>
function toggleDetail(header) {
  header.nextElementSibling.classList.toggle('open');
}

function filterStories(status) {
  document.querySelectorAll('.story-item').forEach(item => {
    if (status === 'all') { item.style.display = ''; return; }
    if (status === 'app-bug') {
      item.style.display = item.dataset.tags.includes('app-bug') ? '' : 'none';
    } else {
      item.style.display = item.dataset.status === status ? '' : 'none';
    }
  });
  document.querySelectorAll('.card').forEach(c => c.classList.remove('active'));
  event.currentTarget.classList.add('active');
}

function filterByTag(tag) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.tag === tag));
  document.querySelectorAll('.story-item').forEach(item => {
    if (tag === 'all') { item.style.display = ''; return; }
    const tags = item.dataset.tags.split(',');
    item.style.display = tags.includes(tag) ? '' : 'none';
  });
}
</script>
</body>
</html>
